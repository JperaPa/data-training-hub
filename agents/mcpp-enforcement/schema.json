{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCPP Enforcement Agent Output Schema",
  "description": "Defines the structure of the MCPP compliance report generated by the MCPP Enforcement Agent.",
  "type": "object",
  "required": [
    "date",
    "overallStatus",
    "steps",
    "findings",
    "recommendations",
    "alignment",
    "sourceFiles"
  ],
  "properties": {
    "date": {
      "type": "string",
      "description": "The date the report was generated (YYYY-MM-DD).",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },

    "overallStatus": {
      "type": "string",
      "enum": ["Compliant", "Partial", "Non-Compliant", "Unable to Evaluate"],
      "description": "Overall compliance status for the day's planning cycle."
    },

    "steps": {
      "type": "object",
      "description": "Compliance evaluation for each of the six MCPP steps.",
      "required": [
        "problemFraming",
        "coaDevelopment",
        "coaWargaming",
        "coaComparisonDecision",
        "ordersDevelopment",
        "transition"
      ],
      "properties": {
        "problemFraming": {
          "type": "object",
          "required": ["status", "notes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["Compliant", "Partial", "Non-Compliant", "Missing"],
              "description": "Compliance status for Problem Framing."
            },
            "notes": {
              "type": "string",
              "description": "Detailed findings for this step."
            }
          }
        },

        "coaDevelopment": {
          "type": "object",
          "required": ["status", "notes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["Compliant", "Partial", "Non-Compliant", "Missing"]
            },
            "notes": {
              "type": "string"
            }
          }
        },

        "coaWargaming": {
          "type": "object",
          "required": ["status", "notes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["Compliant", "Partial", "Non-Compliant", "Missing"]
            },
            "notes": {
              "type": "string"
            }
          }
        },

        "coaComparisonDecision": {
          "type": "object",
          "required": ["status", "notes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["Compliant", "Partial", "Non-Compliant", "Missing"]
            },
            "notes": {
              "type": "string"
            }
          }
        },

        "ordersDevelopment": {
          "type": "object",
          "required": ["status", "notes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["Compliant", "Partial", "Non-Compliant", "Missing"]
            },
            "notes": {
              "type": "string"
            }
          }
        },

        "transition": {
          "type": "object",
          "required": ["status", "notes"],
          "properties": {
            "status": {
              "type": "string",
              "enum": ["Compliant", "Partial", "Non-Compliant", "Missing"]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },

    "findings": {
      "type": "array",
      "description": "List of key issues, gaps, or observations identified during evaluation.",
      "items": {
        "type": "string"
      }
    },

    "recommendations": {
      "type": "array",
      "description": "Actionable recommendations to improve planning compliance.",
      "items": {
        "type": "string"
      }
    },

    "alignment": {
      "type": "object",
      "description": "Assessment of alignment with DTH mission and planning intent.",
      "required": ["missionAlignment", "readinessAssessment"],
      "properties": {
        "missionAlignment": {
          "type": "string",
          "description": "Narrative assessment of how well planning aligns with the DTH mission."
        },
        "readinessAssessment": {
          "type": "string",
          "description": "Assessment of whether planning outputs are ready for execution."
        }
      }
    },

    "sourceFiles": {
      "type": "object",
      "description": "Paths to the input files used for evaluation.",
      "required": ["transcript", "sessionSummary", "reflection"],
      "properties": {
        "transcript": {
          "type": "string",
          "description": "Path to transcript file or null if missing."
        },
        "sessionSummary": {
          "type": "string",
          "description": "Path to session summary file or null if missing."
        },
        "reflection": {
          "type": "string",
          "description": "Path to reflection file or null if missing."
        }
      }
    }
  }
}
