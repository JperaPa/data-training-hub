{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.franciscoperalta.dth",
  "productName": "Data Training Hub",
  "version": "1.0.0",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../../ui",
    "beforeBuildCommand": "npm run build --prefix ../../ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Data Training Hub",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob:"
    }
  }
}
